<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for standard output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for persistent logs -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/fakedata-generation.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set logging level for Slick (can be DEBUG for learning) -->
    <logger name="slick" level="INFO"/>
    <logger name="slick.jdbc.JdbcBackend.statement" level="DEBUG"/>

    <!-- Set logging level for HikariCP connection pool -->
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <!-- Application logging level -->
    <logger name="com.fakedatagen" level="INFO"/>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
